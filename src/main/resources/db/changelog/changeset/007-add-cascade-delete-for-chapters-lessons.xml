<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="7" author="student">
        <dropForeignKeyConstraint baseTableName="chapters"
                                  constraintName="fk_chapters_course"/>

        <addForeignKeyConstraint baseTableName="chapters"
                                 baseColumnNames="course_id"
                                 referencedTableName="courses"
                                 referencedColumnNames="id"
                                 constraintName="fk_chapters_course"
                                 onDelete="CASCADE"/>

        <dropForeignKeyConstraint baseTableName="lessons"
                                  constraintName="fk_lessons_chapter"/>

        <addForeignKeyConstraint baseTableName="lessons"
                                 baseColumnNames="chapter_id"
                                 referencedTableName="chapters"
                                 referencedColumnNames="id"
                                 constraintName="fk_lessons_chapter"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>